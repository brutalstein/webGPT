{
  "app_name": "OS",
  "default_provider": "gemini",
  "language": "tr-TR",
  "inject_local_memory": false,
  "memory_context_max_chars": 6000,
  "storage": {
    "database_file": "os-state.db",
    "automatic_backup": true,
    "backup_interval_hours": 24,
    "backup_keep": 10
  },
  "cli": {
    "recent_session_limit": 30
  },
  "providers": {
    "gemini": {
      "kind": "gemini_chrome_cdp",
      "enabled": true,
      "expected_email": "willieewonka224@gmail.com",
      "preferred_browser": "chrome",
      "preferred_model": "3.1 Pro",
      "inject_local_memory": false,
      "headless_after_setup": true,
      "strict_account_check": false,
      "strict_model_check": false,
      "reuse_previous_working_profile": true,
      "verify_personalization": false,
      "expected_instruction_count": 3,
      "start_new_chat_on_launch": false,
      "response_timeout_seconds": 360,
      "stable_seconds": 5.0,
      "page_timeout_seconds": 60,
      "login_timeout_seconds": 600,
      "launch_mode": "cdp",
      "fallback_to_persistent": true,
      "cdp_start_retries": 3,
      "cdp_port_timeout_seconds": 20
    },
    "chatgpt": {
      "kind": "openai_responses_api",
      "enabled": true,
      "expected_email": "ebru112263gundes@gmail.com",
      "preferred_browser": "none",
      "preferred_model": "gpt-5.2",
      "inject_local_memory": true,
      "api_key_env": "OPENAI_API_KEY",
      "api_base_url": "https://api.openai.com/v1",
      "request_timeout_seconds": 180,
      "max_retries": 4,
      "max_output_tokens": 4096,
      "reasoning_effort": "medium",
      "store_remote_conversation": true,
      "history_replay_turns": 20,
      "developer_instructions": "Türkçe ve doğrudan cevap ver. OS tarafından sağlanan kalıcı kullanıcı bağlamını dikkate al.",
      "model_fallbacks": [
        "gpt-5.1",
        "gpt-5-mini"
      ]
    }
  },
  "local_tools": {
    "enabled": true,
    "provider_allowlist": [
      "gemini"
    ],
    "require_confirmation": true,
    "default_to_process_cwd": true,
    "workspace_state_file": "workspace.json",
    "workspace_preview_entries": 80,
    "max_agent_rounds": 8,
    "max_calls_per_round": 4,
    "protocol_correction_retries": 1,
    "max_tool_result_chars": 24000,
    "max_file_bytes": 1048576,
    "command_timeout_seconds": 120,
    "command_output_chars": 30000,
    "backup_writes": true,
    "protected_path_parts": [
      ".git"
    ],
    "ignored_directories": [
      ".git",
      ".venv",
      "venv",
      "__pycache__",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      "node_modules",
      "dist",
      "build"
    ],
    "allowed_tools": [
      "workspace_info",
      "list_directory",
      "read_file",
      "search_text",
      "write_file",
      "append_file",
      "replace_text",
      "create_directory",
      "run_command",
      "git_status",
      "project_context",
      "search_project_context",
      "refresh_project_context",
      "list_skills",
      "activate_skill",
      "read_skill_resource",
      "inspect_github_skill",
      "install_inspected_skill",
      "uninstall_skill"
    ],
    "allowed_executables": [
      "git",
      "git.exe",
      "python",
      "python.exe",
      "python3",
      "py",
      "py.exe",
      "pytest",
      "pytest.exe",
      "pip",
      "pip.exe",
      "pip3",
      "node",
      "node.exe",
      "npm",
      "npm.cmd",
      "npx",
      "npx.cmd",
      "cmake",
      "cmake.exe",
      "ctest",
      "ctest.exe",
      "ninja",
      "ninja.exe",
      "ruff",
      "ruff.exe",
      "mypy",
      "mypy.exe"
    ],
    "blocked_command_patterns": [
      "\\bgit\\s+reset\\s+--hard\\b",
      "\\bgit\\s+clean\\s+-[^\\s]*f",
      "\\bgit\\s+push\\b.*(?:--force|-f)\\b",
      "\\brm\\s+-rf\\b",
      "\\bdel\\b.*(?:/s|/q)",
      "\\brmdir\\b.*(?:/s|/q)",
      "\\bformat\\b",
      "\\bdiskpart\\b",
      "\\bshutdown\\b",
      "\\bRemove-Item\\b.*-Recurse"
    ],
    "sensitive_file_globs": [
      "*.env",
      ".env*",
      "*credentials*",
      "*secret*",
      "*.pem",
      "*.key",
      "*id_rsa*",
      "*id_ed25519*"
    ]
  },
  "web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8765,
    "open_browser": true,
    "frontend_source_dir": "web",
    "frontend_dist_dir": "web/dist",
    "approval_timeout_seconds": 600,
    "session_limit": 60,
    "event_history_limit": 600,
    "websocket_queue_size": 1000,
    "max_file_preview_bytes": 524288,
    "workspace_tree_entries": 600,
    "workspace_tree_depth": 3,
    "frontend_install_timeout_seconds": 600,
    "frontend_build_timeout_seconds": 180
  },
  "project_context": {
    "enabled": true,
    "cache_keep": 20,
    "max_files": 3500,
    "max_file_bytes": 262144,
    "max_total_text_bytes": 6291456,
    "chunk_chars": 1600,
    "chunk_overlap_chars": 180,
    "retrieval_hits": 6,
    "automatic_retrieval_hits": 5,
    "automatic_context_max_chars": 9000,
    "foundation_files": 4,
    "foundation_context_max_chars": 3500,
    "brief_max_chars": 5000,
    "refresh_min_interval_seconds": 3,
    "git_list_timeout_seconds": 12,
    "excluded_path_prefixes": [
      ".agents/skills",
      ".os/skills"
    ]
  },
  "skills": {
    "enabled": true,
    "project_skill_directories": [
      ".agents/skills",
      ".os/skills"
    ],
    "max_skill_body_chars": 20000,
    "activation_max_chars": 20000,
    "activation_session_limit": 200,
    "max_resource_bytes": 524288,
    "max_files": 250,
    "max_total_bytes": 5242880,
    "max_single_file_bytes": 1048576,
    "git_timeout_seconds": 90,
    "inspection_ttl_seconds": 3600,
    "automatic_script_execution": false
  }
}

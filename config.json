    "allowed_executables": [
      "git",
      "git.exe",
      "python",
      "python.exe",
      "python3",
      "py",
      "py.exe",
      "pytest",
      "pytest.exe",
      "pip",
      "pip.exe",
      "pip3",
      "node",
      "node.exe",
      "npm",
      "npm.cmd",
      "npx",
      "npx.cmd",
      "cmake",
      "cmake.exe",
      "ctest",
      "ctest.exe",
      "ninja",
      "ninja.exe",
      "ruff",
      "ruff.exe",
      "mypy",
      "mypy.exe"
    ],
    "blocked_command_patterns": [
      "\\bgit\\s+reset\\s+--hard\\b",
      "\\bgit\\s+clean\\s+-[^\\s]*f",
      "\\bgit\\s+push\\b.*(?:--force|-f)\\b",
      "\\brm\\s+-rf\\b",
      "\\bdel\\b.*(?:/s|/q)",
      "\\brmdir\\b.*(?:/s|/q)",
      "\\bformat\\b",
      "\\bdiskpart\\b",
      "\\bshutdown\\b",
      "\\bRemove-Item\\b.*-Recurse"

{
  "app_name": "OS",
  "default_provider": "gemini",
  "language": "tr-TR",
  "inject_local_memory": false,
  "memory_context_max_chars": 6000,
  "storage": {
    "database_file": "os-state.db",
    "automatic_backup": true,
    "backup_interval_hours": 24,
    "backup_keep": 10
  },
  "cli": {
    "recent_session_limit": 30
  },
  "providers": {
    "gemini": {
      "kind": "gemini_chrome_cdp",
      "enabled": true,
      "expected_email": "willieewonka224@gmail.com",
      "preferred_browser": "chrome",
      "preferred_model": "3.1 Pro",
      "inject_local_memory": false,
      "headless_after_setup": true,
      "strict_account_check": false,
      "strict_model_check": false,
      "reuse_previous_working_profile": true,
      "verify_personalization": false,
      "expected_instruction_count": 3,
      "start_new_chat_on_launch": false,
      "response_timeout_seconds": 360,
      "stable_seconds": 5.0,
      "page_timeout_seconds": 60,
      "login_timeout_seconds": 600,
      "launch_mode": "cdp",
      "fallback_to_persistent": true,
      "cdp_start_retries": 3,
      "cdp_port_timeout_seconds": 20
    },
    "chatgpt": {
      "kind": "openai_responses_api",
      "enabled": true,
      "expected_email": "ebru112263gundes@gmail.com",
      "preferred_browser": "none",
      "preferred_model": "gpt-5.2",
      "inject_local_memory": true,
      "api_key_env": "OPENAI_API_KEY",
      "api_base_url": "https://api.openai.com/v1",
      "request_timeout_seconds": 180,
      "max_retries": 4,
      "max_output_tokens": 4096,
      "reasoning_effort": "medium",
      "store_remote_conversation": true,
      "history_replay_turns": 20,
      "developer_instructions": "Türkçe ve doğrudan cevap ver. OS tarafından sağlanan kalıcı kullanıcı bağlamını dikkate al.",
      "model_fallbacks": [
        "gpt-5.1",
        "gpt-5-mini"
      ]
    }
  },
  "local_tools": {
    "enabled": false,
    "require_confirmation": true,
    "allowed_commands": []
  }
}
